function capabilityProfile(key,title,desc){
  const section={
    journey:{place:'personal scientific journey',glyphs:['🧭','📊','🎯','🌍'],flow:['Current state','Next objective','Evidence & progress','Opportunities'],actions:['Resume journey','View milestones','Open next step']},
    learn:{place:'adaptive learning environment',glyphs:['📚','🧠','🧪','🎯'],flow:['What you are learning','Interactive explanation','Guided practice','Mastery check'],actions:['Start lesson','Practice now','View pathway']},
    visual:{place:'visual intelligence environment',glyphs:['👁️','🔎','📐','🖼️'],flow:['Original observation','Measurement / comparison','AI candidates','Confidence & provenance'],actions:['Add observation','Compare evidence','Annotate']},
    research:{place:'research environment',glyphs:['🔬','📚','📊','🧬'],flow:['Scientific question','Evidence base','Method / analysis','Interpretation'],actions:['Build study','Inspect evidence','Open notebook']},
    lab:{place:'instrument & simulation environment',glyphs:['🧰','🔬','🖥️','📏'],flow:['Available equipment','Connection mode','Measurement / simulation','Evidence log'],actions:['Declare equipment','Simulate','Review safety']},
    advancement:{place:'qualification & professional pathway',glyphs:['🎓','🗺️','📋','🚀'],flow:['Current qualification','Requirements','Gap to target','Authorized next level'],actions:['Map pathway','Check requirements','Build portfolio']},
    create:{place:'creation & project environment',glyphs:['🎨','🛠️','🗺️','📄'],flow:['Purpose','Scientific inputs','Build / simulate','Deliverable'],actions:['Create artifact','Prototype safely','Package evidence']},
    market:{place:'scientific resource environment',glyphs:['🛍️','🔎','🏛️','✅'],flow:['Scientific need','Verified fit','Provider / resource','Access & transaction'],actions:['Define need','Compare options','Check eligibility']},
    institution:{place:'institutional environment',glyphs:['🏛️','🗺️','🤝','🏢'],flow:['Institution / facility','Capability','Authorized office','Pathway / collaboration'],actions:['Explore institution','Find official path','View capability']},
    language:{place:'scientific language environment',glyphs:['🌐','🎙️','✍️','📚'],flow:['Source meaning','Scientific terminology','Adapted translation','Official status / traceability'],actions:['Translate','Hear terminology','Verify status']},
    signin:{place:'profile & permissions environment',glyphs:['👤','✅','🔐','🧭'],flow:['Identity','Credentials','Permissions','Continuity'],actions:['Edit profile','Verify credential','Manage permissions']}
  }[key]||{place:'scientific environment',glyphs:['✦','🔎','📊','🧭'],flow:['Context','Activity','Evidence','Next step'],actions:['Open','Inspect','Continue']};

  const t=title.toLowerCase();
  let focus=title, modules=[];
  if(key==='learn' && /explore science/.test(t)) modules=[['Scientific fields','Enter the complete organized map of sciences and professions.'],['Departments & domains','Open the selected field into its real academic and professional branches.'],['Topic environment','The room, objects and diagrams change to the exact topic.'],['Practice & mastery','Exercises manipulate the same objects instead of opening a detached quiz.']];
  else if(/question builder/.test(t)) modules=[['Question structure','Population, system, variables, exposure/intervention and outcome.'],['Feasibility','What can actually be measured or tested with available evidence.'],['Evidence gaps','Known, unknown and missing information are separated.'],['Study route','The question opens directly into design, analysis and reproducibility.']];
  else if(/evidence intelligence/.test(t)) modules=[['Claims','What is being asserted.'],['Sources','Where each claim comes from.'],['Confidence','Strength, uncertainty and competing explanations.'],['Reproducibility','Whether another qualified user can reproduce the result.']];
  else if(/study design/.test(t)) modules=[['Design choice','Experimental, observational or computational.'],['Variables & controls','Expose predictors, outcomes, controls and confounders.'],['Sampling','Population, inclusion and data collection plan.'],['Analysis plan','Statistical or computational route before execution.']];
  else if(/analysis & interpretation/.test(t)) modules=[['Data view','Variables, distributions and quality checks.'],['Modeling','Appropriate statistical / computational models.'],['Interpretation','Effect, uncertainty and limitations.'],['Decision boundary','What the data supports and what it does not.']];
  else if(/scientific observation canvas/.test(t)) modules=[['Evidence canvas','Original image/video/specimen remains visible.'],['Measurement tools','Scale, geometry, calibration and annotation.'],['Candidate layer','AI suggestions stay separate from direct evidence.'],['Uncertainty layer','Confidence and alternative interpretations remain visible.']];
  else if(/identify candidates/.test(t)) modules=[['Observed features','Visible traits extracted from the source.'],['Candidate set','Multiple plausible identifications instead of one forced answer.'],['Confidence','Probability / confidence with reasons.'],['Verification','Next observation or test that could discriminate candidates.']];
  else if(/compare/.test(t)) modules=[['Reference A','First specimen / image / object.'],['Reference B','Second specimen / image / object.'],['Difference map','Aligned visual, dimensional or temporal differences.'],['Conclusion','Supported similarities, differences and uncertainty.']];
