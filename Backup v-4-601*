  else if(/organization intelligence/.test(t)) modules=[['Organization map','Scientific hierarchy, departments, facilities and reporting lines become navigable.'],['Authorized decision chain','Routine decisions, reviewers, owners and escalation levels remain explicit.'],['Protected escalation','Sensitive exceptions preserve auditability and route to the correct authorized level.'],['Institutional pathway','The user sees who can act, what is required and how to reach the correct office lawfully.']];
  else if(/public profile|scientific profile/.test(t)) modules=[['Identity & preferences','Only information the user chooses to make visible.'],['Field & level','Scientific interests, training and current stage.'],['Goals','Learning, research, professional or project destination.'],['Continuity','The same context follows future sessions.']];
  else if(/credentials/.test(t)) modules=[['Credential record','Degree, certificate, license or authorization.'],['Issuer','Institution or authority that issued it.'],['Verification','Verified, pending, expired or user-declared status.'],['Permissions','Capabilities unlocked only when legally and institutionally appropriate.']];
  else modules=section.flow.map((x,i)=>[x,[desc,'This element is specific to '+title+'.','The active field and jurisdiction remain attached.','The next action opens inside this same environment.'][i]]);
  return {section,focus,modules};
}

