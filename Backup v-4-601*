  else if(/scientific capability map/.test(t)) modules=[['Facility map','Buildings, laboratories, centers and field sites.'],['Capability layer','What each unit can perform.'],['Equipment layer','Major scientific installations and systems.'],['Access layer','Public, student, staff, collaborator or restricted access.']];
