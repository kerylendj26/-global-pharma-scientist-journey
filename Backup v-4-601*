function paintLabels(key){
  const labels=(sceneBlueprints[key]||sceneBlueprints.learn).labels;
  const el=document.getElementById('sceneLabels'); if(!el) return;
  el.innerHTML=labels.map(x=>`<div class="scene-label"><strong>${x[0]}</strong>${x[1]}</div>`).join('');
