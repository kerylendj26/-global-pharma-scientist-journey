<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>GPSJ v4.61 — Every Capability Opens Inside</title>
<style>
:root{
  --navy:#0d2557; --navy2:#07152f; --ink:#eaf3ff; --muted:#a8b9d8;
  --line:rgba(255,255,255,.14); --glass:rgba(10,28,65,.62); --accent:#6e5bff;
  --cyan:#27d8ff; --green:#74f3b6; --panel:rgba(7,18,42,.72); --card:#f8fbff;
  --cardInk:#142446; --cardMuted:#6a7897; --blue:#2459b8;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:#020817;color:var(--ink)}
body{overflow-x:hidden}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
#app{min-height:100vh;position:relative;isolation:isolate;background:
radial-gradient(circle at 18% 20%,rgba(39,216,255,.13),transparent 34%),
radial-gradient(circle at 82% 12%,rgba(110,91,255,.16),transparent 32%),
linear-gradient(180deg,#091a3d 0%,#031126 58%,#010812 100%)}
#app:before{content:"";position:fixed;inset:0;z-index:-3;opacity:.25;pointer-events:none;
background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
background-size:42px 42px;transform:perspective(900px) rotateX(66deg) scale(1.4);transform-origin:50% 85%}
.glow{position:fixed;border-radius:50%;filter:blur(70px);opacity:.18;z-index:-2;pointer-events:none}
.g1{width:360px;height:360px;background:#19cfff;left:-100px;top:25vh}
.g2{width:420px;height:420px;background:#6b46ff;right:-150px;top:8vh}

header{position:sticky;top:0;z-index:30;padding:20px 24px 18px;
background:linear-gradient(180deg,rgba(6,18,44,.97),rgba(6,18,44,.88));
backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.09)}
.brandrow{display:flex;align-items:center;gap:16px;max-width:1240px;margin:auto}
.logo{width:62px;height:62px;border-radius:18px;display:grid;place-items:center;font-weight:900;
background:linear-gradient(145deg,#4d74ff,#7d3cff);box-shadow:0 12px 35px rgba(85,92,255,.28)}
.brand h1{margin:0;font-size:clamp(24px,4vw,40px);letter-spacing:-.03em}
.brand p{margin:4px 0 0;color:var(--muted);font-size:15px}
.ai-pill{margin-left:auto;padding:12px 16px;border-radius:999px;background:linear-gradient(135deg,#5d58ff,#8b45ff);
font-weight:800;box-shadow:0 8px 28px rgba(100,70,255,.3)}
nav{max-width:1240px;margin:16px auto 0;display:flex;flex-wrap:wrap;gap:10px}
nav button{border:1px solid transparent;color:#eef5ff;background:rgba(255,255,255,.08);padding:12px 15px;border-radius:14px;font-weight:700}
nav button.active,nav button:hover{background:#fff;color:#12234d}
.publicbar{max-width:1240px;margin:14px auto 0;padding:12px 16px;border:1px solid rgba(255,255,255,.12);
background:rgba(232,241,255,.96);color:#214a94;font-weight:800}

main{max-width:1280px;margin:0 auto;padding:24px}
.workspace{background:rgba(245,249,255,.97);color:var(--cardInk);border:1px solid rgba(186,203,231,.8);border-radius:30px;overflow:hidden;box-shadow:0 30px 70px rgba(0,0,0,.18)}
.ws-head{padding:26px;border-bottom:1px solid #dce6f3;display:flex;align-items:flex-start;gap:18px}
.ws-head .title-wrap{flex:1}.ws-kicker{display:inline-block;color:#2c7a5c;background:#e8f6ef;border-radius:999px;padding:7px 11px;font-weight:900;font-size:13px}
.ws-head h2{margin:8px 0 4px;font-size:34px;letter-spacing:-.03em}.ws-head p{margin:0;color:#71809e}
.ws-actions{display:flex;gap:10px}.ws-actions button{padding:12px 16px;border-radius:12px;border:1px solid #d7e1ef;background:#eef4fb;color:#244b89;font-weight:800}
.ws-body{padding:26px;position:relative}
.context{border:1px solid #d8e2f1;border-radius:18px;background:linear-gradient(90deg,#f1f6ff,#f5f1ff);padding:18px;margin-bottom:18px}
.context strong{color:#2b559c}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.chip{padding:7px 10px;border:1px solid #d5e0ef;border-radius:999px;background:#fff;font-size:13px;font-weight:700;color:#2e4f88}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.card{border:1px solid #d8e2f0;background:#fff;border-radius:20px;padding:22px;min-height:190px;position:relative;overflow:hidden;transition:.2s transform,.2s box-shadow}
.card:hover{transform:translateY(-2px);box-shadow:0 16px 32px rgba(34,67,125,.1)}
.card.featured{outline:2px solid #7e9cff}.card .relevant{display:inline-block;font-size:11px;font-weight:900;color:#315899;background:#edf3ff;padding:6px 9px;border-radius:999px;margin-bottom:12px}
.card-icon{width:64px;height:64px;border-radius:18px;display:grid;place-items:center;font-size:34px;margin-bottom:16px;background:linear-gradient(145deg,#edf5ff,#f3efff);border:1px solid #d6e3f3;box-shadow:0 10px 24px rgba(42,83,151,.10)}
.card h3{font-size:24px;margin:0 0 8px;letter-spacing:-.02em}.card p{margin:0;color:var(--cardMuted);font-size:17px;line-height:1.45}
.card button{margin-top:18px;padding:10px 14px;border-radius:12px;border:1px solid #d6e0ee;background:#eef4fb;color:#21519a;font-weight:850}
.card .scene-preview{position:absolute;right:-28px;bottom:-30px;width:160px;height:120px;border-radius:36px;opacity:.14;background:
radial-gradient(circle at 50% 50%,#35dfff,transparent 44%),linear-gradient(135deg,#5f64ff,#1fe0bf)}
.note{margin-top:18px;border-left:4px solid #4266ff;padding:16px 18px;background:#eef3fb;border-radius:14px;color:#20345c}
.level-strip{margin-top:18px;border:1px solid #d9e3f0;border-radius:18px;background:#f9fbff;padding:16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.level-strip strong{color:#2e58a2;margin-right:auto}
.level{padding:7px 10px;border-radius:999px;border:1px solid #d7e1ed;background:#fff;font-weight:700;font-size:13px}.level.active{border-color:#6c86ff;color:#3156ad;background:#f0f4ff}

.hero{position:relative;min-height:62vh;border:1px solid var(--line);border-radius:34px;overflow:hidden;background:
linear-gradient(90deg,rgba(3,13,32,.9) 0%,rgba(3,13,32,.44) 45%,rgba(3,13,32,.18) 100%),
radial-gradient(circle at 72% 40%,rgba(38,196,255,.22),transparent 26%),
linear-gradient(140deg,#102b61,#09152d 55%,#030912);box-shadow:0 35px 80px rgba(0,0,0,.32)}
.hero:before{content:"";position:absolute;inset:0;opacity:.8;background:
radial-gradient(circle at 76% 40%,rgba(255,255,255,.1) 0 1px,transparent 2px) 0 0/26px 26px,
linear-gradient(115deg,transparent 47%,rgba(37,215,255,.18) 49%,transparent 51%);animation:scan 8s linear infinite}
@keyframes scan{0%{transform:translateX(-3%)}50%{transform:translateX(3%)}100%{transform:translateX(-3%)}}
.hero-copy{position:relative;z-index:2;max-width:650px;padding:56px}
.kicker{display:inline-flex;gap:8px;align-items:center;padding:8px 12px;border:1px solid rgba(124,241,255,.28);border-radius:999px;background:rgba(16,58,95,.5);font-size:13px;font-weight:800;color:#9deeff}
.hero h2{font-size:clamp(40px,7vw,78px);line-height:.96;margin:18px 0 16px;letter-spacing:-.055em}.hero p{font-size:19px;line-height:1.55;color:#c6d6ef;max-width:580px}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.cta button{padding:14px 18px;border-radius:14px;border:0;font-weight:850}.primary{background:linear-gradient(135deg,#48d8ff,#735cff);color:#fff}.secondary{background:rgba(255,255,255,.09);color:#fff;border:1px solid var(--line)!important}
.avatar-stage{position:absolute;right:3%;bottom:0;width:min(48%,560px);height:95%;z-index:1}.person{position:absolute;left:28%;bottom:8%;width:35%;aspect-ratio:.62;border-radius:45% 45% 26% 26%/28% 28% 12% 12%;background:linear-gradient(180deg,#87e8ff 0 22%,#26396b 22% 100%);filter:drop-shadow(0 22px 24px rgba(0,0,0,.38))}
.person:before{content:"";position:absolute;width:48%;aspect-ratio:1;border-radius:50%;left:26%;top:-18%;background:linear-gradient(145deg,#f5c9a7,#9e684e)}.person:after{content:"";position:absolute;width:92%;height:17%;left:4%;top:30%;border:2px solid rgba(78,233,255,.55);border-radius:18px;box-shadow:0 0 22px rgba(60,221,255,.28)}
.holo{position:absolute;right:0;top:18%;width:66%;height:46%;border:1px solid rgba(101,227,255,.4);border-radius:26px;background:linear-gradient(145deg,rgba(22,147,224,.14),rgba(93,82,255,.16));box-shadow:inset 0 0 42px rgba(31,196,255,.09),0 0 35px rgba(31,196,255,.08);transform:perspective(800px) rotateY(-12deg)}
.holo:before,.holo:after{content:"";position:absolute;border:1px solid rgba(63,222,255,.35);border-radius:50%}.holo:before{width:34%;aspect-ratio:1;left:10%;top:18%;box-shadow:0 0 30px rgba(69,218,255,.18)}.holo:after{width:52%;aspect-ratio:1;right:8%;bottom:5%;border-style:dashed;animation:spin 12s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}

.page{display:none}.page.active{display:block}
.world{display:none;min-height:calc(100vh - 170px);padding:0 0 40px}.world.active{display:block}
.world-shell{position:relative;min-height:78vh;border:1px solid var(--line);border-radius:32px;overflow:hidden;background:#06142e}
.world-bg{position:absolute;inset:0;background:radial-gradient(circle at 70% 32%,rgba(44,221,255,.22),transparent 24%),linear-gradient(135deg,#0c2d58,#06142e 55%,#020814)}
.world-grid{position:absolute;inset:0;opacity:.3;background:linear-gradient(rgba(105,220,255,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(105,220,255,.12) 1px,transparent 1px);background-size:52px 52px;transform:perspective(900px) rotateX(64deg) scale(1.35);transform-origin:50% 85%}
.world-top{position:relative;z-index:3;display:flex;align-items:center;gap:12px;padding:22px}.world-top button{border:1px solid var(--line);background:rgba(255,255,255,.08);color:white;border-radius:12px;padding:10px 14px;font-weight:800}.world-top .spacer{flex:1}.world-title{font-size:clamp(28px,5vw,52px);font-weight:900;letter-spacing:-.04em}
.labscene{position:relative;z-index:2;min-height:620px;margin:12px 22px 22px;border-radius:28px;overflow:hidden;border:1px solid rgba(117,226,255,.18);background:linear-gradient(180deg,rgba(2,10,26,.2),rgba(2,10,26,.86)),radial-gradient(circle at 54% 37%,rgba(45,227,255,.18),transparent 20%),linear-gradient(135deg,#173267,#08152d 62%,#040915)}
.bench{position:absolute;left:8%;right:8%;bottom:10%;height:18%;background:linear-gradient(#203c68,#0b1d3c);transform:perspective(700px) rotateX(48deg);border:1px solid rgba(255,255,255,.12)}
.screen3d{position:absolute;right:9%;top:14%;width:38%;height:40%;border-radius:26px;border:1px solid rgba(89,230,255,.4);background:rgba(19,100,166,.16);box-shadow:0 0 50px rgba(39,216,255,.12),inset 0 0 60px rgba(39,216,255,.08)}
.screen3d:before{content:"";position:absolute;inset:12%;border:2px solid rgba(107,237,255,.35);border-radius:50%;box-shadow:0 0 28px rgba(83,222,255,.18)}
.flask,.scope,.tablet{position:absolute;bottom:18%;filter:drop-shadow(0 12px 16px rgba(0,0,0,.35))}.flask{left:19%;width:70px;height:92px;border:5px solid #72e9ff;border-top:0;border-radius:12px 12px 34px 34px;background:linear-gradient(transparent 45%,rgba(126,89,255,.65) 46%)}.scope{left:40%;width:100px;height:120px;border-left:14px solid #a5bad9;border-bottom:18px solid #7085aa;border-radius:50px 8px 12px 14px;transform:rotate(-8deg)}.tablet{right:23%;width:150px;height:90px;border:6px solid #7d93b8;border-radius:14px;background:linear-gradient(135deg,#0a2e54,#176aa0)}
.hotspot{position:absolute;z-index:5;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.6);background:rgba(67,222,255,.2);box-shadow:0 0 0 10px rgba(67,222,255,.07),0 0 32px rgba(67,222,255,.35);animation:pulse 2s ease-in-out infinite;color:white;font-weight:900}@keyframes pulse{50%{transform:scale(1.08);box-shadow:0 0 0 16px rgba(67,222,255,.02),0 0 44px rgba(67,222,255,.45)}}.h1{left:22%;bottom:37%}.h2{left:43%;bottom:39%}.h3{right:26%;bottom:34%}.h4{right:18%;top:28%}
.hud{position:absolute;left:24px;bottom:24px;z-index:7;width:min(540px,calc(100% - 48px));padding:18px;border:1px solid var(--line);border-radius:18px;background:rgba(4,17,39,.8);backdrop-filter:blur(14px)}.hud small{color:#83eaff;font-weight:800}.hud h3{margin:7px 0 6px;font-size:23px}.hud p{margin:0;color:#c5d3e8;line-height:1.45}.hud-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.hud-actions button{padding:9px 11px;border-radius:10px;border:1px solid var(--line);background:rgba(255,255,255,.08);color:white}
.overlay{position:fixed;inset:0;z-index:80;background:rgba(0,6,18,.7);display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(10px)}.overlay.show{display:flex}.modal{width:min(560px,96vw);border:1px solid var(--line);border-radius:24px;background:#081a3b;padding:24px;box-shadow:0 30px 80px rgba(0,0,0,.45)}.modal h3{margin:0 0 8px}.modal p{color:#c6d5eb;line-height:1.5}.modal button{margin-top:12px;padding:10px 14px;border:0;border-radius:12px;background:#fff;color:#10234d;font-weight:800}
footer{max-width:1240px;margin:30px auto 0;padding:20px 0 40px;color:#7f94b7;font-size:13px}


/* v4.56.9 deeper living-world layer — approved first-level displays remain untouched */
.world-shell{background:#031027;box-shadow:0 36px 90px rgba(0,0,0,.42)}
.world-bg{transition:background .5s ease,filter .5s ease}
.world-shell[data-theme="learn"] .world-bg{background:radial-gradient(circle at 72% 30%,rgba(57,220,255,.26),transparent 22%),radial-gradient(circle at 24% 72%,rgba(116,91,255,.22),transparent 25%),linear-gradient(135deg,#10275b,#06142e 58%,#020813)}
.world-shell[data-theme="visual"] .world-bg{background:radial-gradient(circle at 72% 36%,rgba(63,255,212,.20),transparent 22%),linear-gradient(135deg,#052f43,#07172f 60%,#02070e)}
.world-shell[data-theme="research"] .world-bg{background:radial-gradient(circle at 70% 31%,rgba(164,105,255,.26),transparent 23%),linear-gradient(135deg,#1b174d,#07142f 58%,#020817)}
.world-shell[data-theme="lab"] .world-bg{background:radial-gradient(circle at 72% 31%,rgba(26,224,255,.24),transparent 20%),linear-gradient(135deg,#07375a,#06142d 58%,#010713)}
.world-shell[data-theme="institution"] .world-bg{background:radial-gradient(circle at 70% 32%,rgba(255,205,100,.20),transparent 25%),linear-gradient(135deg,#24304f,#09162f 60%,#020815)}
.world-shell[data-theme="advancement"] .world-bg{background:radial-gradient(circle at 70% 34%,rgba(100,255,178,.18),transparent 22%),linear-gradient(135deg,#0d3a45,#081631 60%,#020815)}
.world-shell[data-theme="market"] .world-bg{background:radial-gradient(circle at 72% 34%,rgba(255,128,216,.18),transparent 25%),linear-gradient(135deg,#332050,#07142f 60%,#020815)}
.world-shell[data-theme="language"] .world-bg{background:radial-gradient(circle at 70% 31%,rgba(77,191,255,.23),transparent 23%),linear-gradient(135deg,#0a3355,#07142f 60%,#020815)}
.world-shell[data-theme="create"] .world-bg{background:radial-gradient(circle at 72% 34%,rgba(255,151,93,.20),transparent 22%),linear-gradient(135deg,#402340,#07142f 60%,#020815)}
.world-shell[data-theme="journey"] .world-bg,.world-shell[data-theme="signin"] .world-bg{background:radial-gradient(circle at 72% 31%,rgba(86,216,255,.20),transparent 24%),linear-gradient(135deg,#102b61,#07142f 60%,#020815)}
.world-stage{position:relative;z-index:2;min-height:670px;margin:12px 22px 22px;border-radius:28px;overflow:hidden;border:1px solid rgba(124,218,255,.24);background:linear-gradient(180deg,rgba(3,12,30,.08),rgba(2,9,24,.78));box-shadow:inset 0 0 80px rgba(29,173,255,.05)}
.world-stage:before{content:"";position:absolute;left:7%;right:7%;bottom:8%;height:25%;border:1px solid rgba(103,221,255,.18);transform:perspective(700px) rotateX(58deg);transform-origin:50% 100%;background:linear-gradient(rgba(80,211,255,.10) 1px,transparent 1px),linear-gradient(90deg,rgba(80,211,255,.10) 1px,transparent 1px);background-size:32px 32px}
.scene-object{position:absolute;transition:.45s ease;filter:drop-shadow(0 20px 25px rgba(0,0,0,.42))}
.scene-main{left:11%;bottom:18%;width:30%;height:42%;border:1px solid rgba(104,229,255,.28);border-radius:24px;background:linear-gradient(145deg,rgba(36,92,158,.35),rgba(9,24,55,.65));box-shadow:inset 0 0 55px rgba(57,203,255,.09),0 0 44px rgba(42,209,255,.08)}
.scene-main:before{content:"";position:absolute;inset:12%;border:2px solid rgba(110,231,255,.42);border-radius:20px;clip-path:polygon(0 15%,100% 0,94% 100%,8% 88%)}
.scene-console{right:8%;top:13%;width:42%;height:42%;border:1px solid rgba(110,229,255,.30);border-radius:24px;background:linear-gradient(145deg,rgba(15,86,145,.30),rgba(76,73,190,.18));box-shadow:inset 0 0 55px rgba(50,220,255,.08),0 0 40px rgba(41,198,255,.08)}
.scene-console:before{content:"";position:absolute;left:7%;right:7%;top:10%;height:42%;border:1px solid rgba(120,231,255,.30);border-radius:18px;background:radial-gradient(circle at 30% 50%,rgba(64,233,255,.20),transparent 24%),linear-gradient(90deg,transparent 12%,rgba(122,229,255,.12) 13% 14%,transparent 15% 100%)}
.scene-console:after{content:"";position:absolute;left:8%;right:8%;bottom:11%;height:24%;background:repeating-linear-gradient(90deg,rgba(116,232,255,.25) 0 5px,transparent 5px 19px);border-radius:12px;opacity:.7}
.ai-orb{position:absolute;right:23%;bottom:25%;width:105px;aspect-ratio:1;border-radius:50%;border:1px solid rgba(146,242,255,.55);background:radial-gradient(circle at 35% 35%,#baf7ff 0 3%,#4fdbff 8%,rgba(52,148,255,.58) 28%,rgba(74,72,226,.18) 61%,transparent 70%);box-shadow:0 0 60px rgba(50,213,255,.35),inset 0 0 28px rgba(255,255,255,.15);animation:floatOrb 4s ease-in-out infinite}
@keyframes floatOrb{50%{transform:translateY(-12px) scale(1.04)}}
.ai-rings{position:absolute;right:15%;bottom:14%;width:250px;aspect-ratio:1;border:1px dashed rgba(101,225,255,.28);border-radius:50%;animation:spin 18s linear infinite}.ai-rings:after{content:"";position:absolute;inset:18%;border:1px solid rgba(125,230,255,.30);border-radius:50%}
.world-taskbar{position:absolute;left:24px;right:24px;top:24px;z-index:7;display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:12px;border:1px solid rgba(255,255,255,.12);border-radius:16px;background:rgba(4,17,39,.68);backdrop-filter:blur(14px)}
.world-taskbar input{flex:1;min-width:240px;border:1px solid rgba(255,255,255,.16);border-radius:12px;background:rgba(255,255,255,.08);color:white;padding:12px 14px;outline:none}.world-taskbar input::placeholder{color:#a9bbd5}
.world-taskbar button{border:1px solid rgba(255,255,255,.14);border-radius:12px;background:linear-gradient(135deg,#35d4ff,#6758ff);color:white;font-weight:800;padding:11px 14px}
.scene-labels{position:absolute;right:5%;top:58%;z-index:6;width:min(410px,44%);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scene-label{padding:11px 12px;border-radius:13px;border:1px solid rgba(112,224,255,.18);background:rgba(6,22,49,.72);color:#d5e8fa;font-size:13px;backdrop-filter:blur(12px)}.scene-label strong{display:block;color:#8feaff;margin-bottom:3px}
.world-status{position:absolute;right:24px;bottom:24px;z-index:8;max-width:360px;padding:13px 15px;border:1px solid rgba(125,233,255,.20);border-radius:14px;background:rgba(3,17,40,.80);color:#bcd0e8;font-size:13px}.world-status strong{color:#8ef0d0}
.hud{max-height:300px}

@media(max-width:900px){.cards{grid-template-columns:1fr 1fr}.avatar-stage{opacity:.45;width:62%}.hero-copy{padding:38px 28px}}
@media(max-width:640px){
  header{padding:16px 14px}.brand p{display:none}.logo{width:50px;height:50px}.ai-pill{padding:10px 12px}
  main{padding:14px}.cards{grid-template-columns:1fr}.ws-head{padding:20px;flex-direction:column}.ws-actions{width:100%}.ws-head h2{font-size:30px}
  .hero{min-height:68vh}.hero h2{font-size:46px}.hero-copy{padding:34px 22px}.avatar-stage{width:92%;right:-26%;opacity:.4}
  .world-top{padding:16px;flex-wrap:wrap}.world-title{font-size:30px}.labscene{margin:8px 12px 12px;min-height:650px}.screen3d{width:56%;right:4%}.hud{left:12px;bottom:12px;width:calc(100% - 24px)}
}

/* v4.58 nested-world depth */
.depth-nav{position:absolute;left:24px;right:24px;top:86px;z-index:9;display:flex;gap:8px;flex-wrap:wrap}
