function openLesson(topicId,moduleIndex=0,step='principle'){
 state.currentTopic=topicId; state.currentModule=moduleIndex; state.currentStep=step; localStorage.setItem('gpsjLastLesson',JSON.stringify({topic:topicId,module:moduleIndex,step}));
 const topic=topicData.find(t=>t.id===topicId);
 document.getElementById('lessonModal').classList.add('open');
 document.getElementById('lessonModalTitle').textContent=topic.title;
 document.getElementById('lessonTitle').textContent=topic.modules[moduleIndex];
 document.getElementById('lessonSubtitle').textContent='Learn the relationship first, then see it, manipulate it, explain it and verify understanding.';
 document.getElementById('lessonBreadcrumb').textContent=`${topic.title} · Module ${moduleIndex+1} of ${topic.modules.length}`;
 document.getElementById('lessonModuleList').innerHTML=topic.modules.map((m,i)=>`<button class="btn ${i===moduleIndex?'primary':''} lesson-module" data-i="${i}">${i+1}. ${m}</button>`).join('');
 document.querySelectorAll('.lesson-module').forEach(b=>b.onclick=()=>openLesson(topicId,+b.dataset.i,'principle'));
 document.querySelectorAll('.lesson-step').forEach(b=>b.classList.toggle('active',b.dataset.step===step));
 document.querySelectorAll('.depth-btn').forEach(x=>x.classList.toggle('active',x.dataset.depth===state.depth));
 renderLessonStep();
}
