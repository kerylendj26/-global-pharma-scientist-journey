 document.querySelectorAll('.lesson-step').forEach(b=>b.classList.toggle('active',b.dataset.step===state.currentStep));
 if(state.currentStep==='principle'){
   box.innerHTML=`<div class="content-box"><h3>Scientific principle first</h3><div style="font-size:24px;font-weight:800;background:var(--soft);padding:18px;border-radius:14px">${principleText(topic.id,state.currentModule)}</div><p style="color:var(--muted)">GPSJ should explain the relationship before asking the learner to memorize a procedure.</p><button class="btn primary next-step">See it visually →</button></div>`;
