<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Global Pharma Scientist Journey — Functional Prototype v3.8</title>
<style>
:root{
  --nav:#0e224d; --nav2:#173b87; --blue:#2f58e9; --purple:#7645e7;
  --bg:#f3f6fb; --card:#fff; --text:#13213e; --muted:#66728c; --line:#d9e2f2;
  --green:#0f8d62; --warn:#9b6a00; --soft:#edf3ff; --shadow:0 10px 30px rgba(17,40,85,.12);
}
*{box-sizing:border-box}
html{scroll-behavior:auto}
body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;background:var(--bg);color:var(--text)}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
#app{min-height:100vh}
.topbar{position:sticky;top:0;z-index:50;background:linear-gradient(135deg,var(--nav),#101f43);color:#fff;padding:14px 18px 10px;box-shadow:0 4px 18px rgba(0,0,0,.12)}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:48px;height:48px;border-radius:16px;background:linear-gradient(135deg,var(--blue),var(--purple));display:grid;place-items:center;font-weight:800}
.brand h1{font-size:22px;margin:0}
.brand p{margin:2px 0 0;color:#c7d4f3;font-size:13px}
.navrow{display:flex;gap:8px;overflow-x:auto;padding:12px 0 4px;scrollbar-width:none}
.navrow::-webkit-scrollbar{display:none}
.navbtn,.utility-btn{border:0;color:white;background:transparent;padding:10px 14px;border-radius:12px;font-weight:700;white-space:nowrap}
.navbtn.active{background:rgba(255,255,255,.14)}
.utility-row{display:flex;gap:8px;align-items:center;margin-top:6px;flex-wrap:wrap}
.utility-btn{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);padding:8px 12px}
.utility-btn.accent{background:#fff;color:var(--nav)}
.main{max-width:1200px;margin:0 auto;padding:22px}
.view{display:none}
.view.active{display:block}
.hero{border-radius:28px;padding:28px;color:#fff;background:linear-gradient(135deg,#143a93,#6e45df);box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero h2{font-size:40px;line-height:1.05;margin:0 0 14px}
.hero p{max-width:760px;font-size:18px;line-height:1.5;margin:0}
.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;align-items:center}
.hero-card{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);padding:18px;border-radius:20px}
.section{margin-top:24px}
.section h2{font-size:32px;margin:0 0 8px}
.section p.lead{color:var(--muted);font-size:17px;margin:0 0 18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:20px;box-shadow:0 2px 8px rgba(17,40,85,.03)}
.grid{display:grid;gap:16px}
.grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.topic-card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.2s;min-height:220px}
.topic-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.topic-img{height:130px;background-size:cover;background-position:center}
.topic-body{padding:16px}
.topic-body h3{margin:0 0 8px;font-size:20px}
.topic-body p{margin:0 0 14px;color:var(--muted);line-height:1.45}
.btn{border:0;border-radius:12px;padding:11px 16px;font-weight:800;background:var(--soft);color:#23499a}
.btn.primary{background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff}
.btn.secondary{background:#fff;border:1px solid var(--line);color:#23499a}
.btn.danger{background:#fff0f0;color:#a22}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:8px 11px;border-radius:999px;background:var(--soft);color:#284c98;border:1px solid #dce6fb;font-weight:700;font-size:13px}
.searchbar{display:flex;gap:10px;margin-bottom:16px}
.searchbar input{flex:1;border:1px solid var(--line);border-radius:14px;padding:14px 16px;font-size:16px}
.panel-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
.panel-title h3{margin:0;font-size:22px}
.backstrip{position:fixed;left:12px;bottom:18px;z-index:80;display:flex;gap:8px}
.backstrip button{width:46px;height:46px;border-radius:50%;border:0;box-shadow:var(--shadow);background:#fff;color:var(--nav);font-size:20px}
.breadcrumb{font-size:13px;color:var(--muted);margin-bottom:10px}
.lesson-shell{display:grid;grid-template-columns:250px 1fr;gap:18px}
.lesson-sidebar{position:sticky;top:170px;align-self:start}
.lesson-sidebar .btn{width:100%;text-align:left;margin-bottom:8px}
.lesson-main{min-width:0}
.lesson-header{padding:24px;border-radius:22px;color:#fff;background:linear-gradient(135deg,#12336e,#27499b)}
.lesson-header h2{margin:0 0 8px;font-size:32px}
.lesson-steps{display:flex;gap:8px;overflow-x:auto;margin:14px 0}
.lesson-step{white-space:nowrap;border:1px solid var(--line);background:#fff;color:#23499a;padding:9px 12px;border-radius:999px;font-weight:800}
.lesson-step.active{background:var(--blue);color:#fff;border-color:transparent}
.content-box{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;margin-top:14px}
.content-box h3{margin-top:0}
.visual-wrap{display:grid;grid-template-columns:1fr 320px;gap:18px}
.visual-stage{border-radius:20px;overflow:hidden;background:#081d43;min-height:420px;position:relative}
.visual-stage img,.visual-stage video{width:100%;height:100%;min-height:420px;object-fit:cover;display:block}
.visual-overlay{position:absolute;left:0;right:0;bottom:0;padding:22px;background:linear-gradient(transparent,rgba(3,13,36,.92));color:#fff}
.visual-controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.range-row{display:grid;grid-template-columns:160px 1fr 50px;gap:10px;align-items:center;margin:12px 0}
.range-row input{width:100%}
.audio-controls{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.speed-row{display:flex;gap:8px;flex-wrap:wrap}
.speed{border:1px solid var(--line);background:#fff;color:#23499a;border-radius:999px;padding:7px 10px;font-weight:800}
.speed.active{background:var(--blue);color:#fff}
.creator-output{min-height:220px;white-space:pre-wrap;border:1px solid var(--line);border-radius:14px;padding:16px;background:#fbfcff}
.market-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.market-card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px}
.market-card h3{margin:0 0 6px}
.status{font-size:12px;font-weight:800;padding:5px 8px;border-radius:999px;background:#eaf8f2;color:#147658;display:inline-block}
.notice{background:#fff8e8;border:1px solid #f0d78d;color:#7d5a00;padding:14px;border-radius:14px}
.lang-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.lang-card{border:1px solid var(--line);border-radius:16px;padding:14px;background:#fff}
.mastery-bar{height:10px;background:#e7edf9;border-radius:999px;overflow:hidden}.mastery-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--purple))}.depth-row{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.depth-btn{border:1px solid var(--line);background:#fff;color:#23499a;border-radius:999px;padding:8px 11px;font-weight:800}.depth-btn.active{background:var(--blue);color:#fff;border-color:transparent}.module-meta{font-size:12px;color:var(--muted);margin-top:4px}.continue-card{background:linear-gradient(135deg,#eef4ff,#f5efff);border:1px solid #d8e2fb}.lesson-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.hidden{display:none!important}
.modal{position:fixed;inset:0;z-index:100;background:rgba(5,16,40,.72);display:none;align-items:center;justify-content:center;padding:16px}
.modal.open{display:flex}
.modal-card{width:min(1100px,96vw);max-height:92vh;overflow:auto;background:var(--bg);border-radius:24px;box-shadow:0 20px 70px rgba(0,0,0,.35)}
.modal-head{position:sticky;top:0;z-index:2;background:linear-gradient(135deg,var(--nav2),var(--purple));color:#fff;padding:16px 20px;display:flex;justify-content:space-between;align-items:center}
.modal-head button{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:12px;padding:8px 12px}
.modal-body{padding:20px}
.stack{display:flex;flex-direction:column;gap:12px}
.field label{display:block;font-weight:800;margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:12px;padding:12px}
@media(max-width:900px){
 .main{padding:14px}
 .hero-grid,.visual-wrap,.grid.cols-2,.grid.cols-3,.topic-grid,.market-grid,.lang-grid{grid-template-columns:1fr}
 .hero h2{font-size:32px}
 .lesson-shell{grid-template-columns:1fr}
 .lesson-sidebar{position:static}
 .lesson-sidebar .stack{display:grid;grid-template-columns:repeat(2,1fr)}
 .range-row{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div id="app">
  <header class="topbar">
    <div class="brand">
      <div class="logo">GPSJ</div>
      <div>
        <h1>Global Pharma Scientist Journey</h1>
        <p>Functional Prototype v3.8 · Deep Adaptive Curriculum, Mastery Tracking & Connected Workflows</p>
      </div>
    </div>
    <nav class="navrow" id="navrow">
      <button class="navbtn active" data-view="home">Home</button>
      <button class="navbtn" data-view="identity">Identity & Profile</button>
      <button class="navbtn" data-view="journey">My Journey</button>
      <button class="navbtn" data-view="intelligence">My Intelligence</button>
      <button class="navbtn" data-view="projects">Projects</button>
      <button class="navbtn" data-view="learn">Learn</button>
      <button class="navbtn" data-view="practice">Practice</button>
      <button class="navbtn" data-view="research">Research</button>
      <button class="navbtn" data-view="build">Build</button>
      <button class="navbtn" data-view="marketplace">Marketplace</button>
      <button class="navbtn" data-view="career">Career</button>
      <button class="navbtn" data-view="create">Create</button>
    </nav>
    <div class="utility-row">
      <button class="utility-btn accent" id="languageBtn">Language Center</button>
      <button class="utility-btn" id="employeeBtn">👤 Employee</button>
      <button class="utility-btn" id="homeBackupBtn">↩ Backup / Home</button>
    </div>
  </header>

  <main class="main">
    <section id="view-home" class="view active">
      <div class="hero">
        <div class="hero-grid">
          <div>
            <div class="chip" style="background:rgba(255,255,255,.14);color:white;border-color:rgba(255,255,255,.25)">🌍 One verified identity · lifelong scientific intelligence</div>
            <h2>Your scientific world, shaped around what you are becoming.</h2>
            <p>GPSJ connects learning, professional practice, research, building, creation, commerce and career intelligence while adapting depth, language, security and regulatory context to the user.</p>
            <div class="chips" style="margin-top:18px">
              <span class="chip">Jurisdiction-aware</span><span class="chip">Science-first education</span><span class="chip">Adaptive security</span><span class="chip">Multilingual audio</span>
            </div>
          </div>
          <div class="hero-card">
            <h3 style="margin-top:0">Context Engine</h3>
            <p style="font-size:15px">Geography + profession + education + project + permissions → a different GPSJ for each verified user.</p>
            <button class="btn primary" style="margin-top:14px" data-goto="learn">Enter learning engine</button>
          </div>
        </div>
      </div>

      <div class="section">
        <h2>Quick launch</h2>
        <p class="lead">Open only what you requested. Navigation no longer jumps the page to unrelated sections.</p>
        <div class="grid cols-3">
          <div class="card"><h3>Learn</h3><p>Browse all fields, search any topic, then adapt from broad → specific.</p><button class="btn primary" data-goto="learn">Open Learn</button></div>
          <div class="card"><h3>Create</h3><p>Generate real editable drafts, reports, presentations, research maps and translations.</p><button class="btn primary" data-goto="create">Open Creator Studio</button></div>
          <div class="card"><h3>Marketplace</h3><p>Browse accessible science tools first, then reveal regulated categories only when permitted.</p><button class="btn primary" data-goto="marketplace">Open Marketplace</button></div>
        </div>
      </div>
    </section>

    <section id="view-learn" class="view">
      <div class="section" style="margin-top:0">
        <div class="panel-title"><div><h2>Learning Library</h2><p class="lead">Choose a field or search any subject. GPSJ narrows from broad → domain → topic → lesson → practice.</p></div></div>
        <div class="searchbar">
          <input id="learnSearch" placeholder="Search anything: pharmacology, organic chemistry, toxicology, microbiology, statistics, formulation..." />
          <button class="btn primary" id="searchLearnBtn">Search</button>
        </div>
        <div class="chips" style="margin-bottom:16px">
          <span class="chip">Medicine</span><span class="chip">Pharmacy</span><span class="chip">Biology</span><span class="chip">Chemistry</span><span class="chip">Biotechnology</span><span class="chip">Toxicology</span><span class="chip">Public health</span><span class="chip">Engineering</span><span class="chip">Research methods</span>
        </div>
        <div id="continueLearning" class="card continue-card" style="margin-bottom:16px;display:none"></div>
        <div id="topicGrid" class="topic-grid"></div>
      </div>
    </section>

    <section id="view-create" class="view">
      <div class="section" style="margin-top:0">
        <h2>Scientific Creator Studio</h2>
        <p class="lead">The buttons below now open working creator tools instead of dead placeholders.</p>
        <div class="grid cols-2">
          <div class="card">
            <div class="panel-title"><h3>📄 Report Builder</h3><button class="btn primary creator-open" data-type="Report">Open</button></div>
            <p>Structure scientific and professional reports from an active topic or project.</p>
          </div>
          <div class="card">
            <div class="panel-title"><h3>📊 Presentation Studio</h3><button class="btn primary creator-open" data-type="Presentation">Open</button></div>
            <p>Build lecture, research, project, business or educational presentation outlines.</p>
          </div>
          <div class="card">
            <div class="panel-title"><h3>🗺️ Research Map Studio</h3><button class="btn primary creator-open" data-type="Research Map">Open</button></div>
            <p>Turn evidence, regions, institutions and project questions into a structured map brief.</p>
          </div>
          <div class="card">
            <div class="panel-title"><h3>🌐 Translation Center</h3><button class="btn primary creator-open" data-type="Translation">Open</button></div>
            <p>Prepare multilingual scientific material with domain-specific terminology.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="view-marketplace" class="view">
      <div class="section" style="margin-top:0">
        <h2>Scientific Marketplace</h2>
        <p class="lead">This prototype is no longer blocked: accessible categories can be inspected immediately. Higher-risk categories show why access is gated.</p>
        <div class="chips" id="marketTabs" style="margin-bottom:16px">
          <button class="btn primary market-tab" data-market="accessible">Accessible</button>
          <button class="btn secondary market-tab" data-market="laboratory">Laboratory</button>
          <button class="btn secondary market-tab" data-market="clinical">Clinical</button>
          <button class="btn secondary market-tab" data-market="institutional">Institutional</button>
        </div>
        <div id="marketGrid" class="market-grid"></div>
        <div class="notice" style="margin-top:18px">Production transactions still require current supplier, jurisdiction, credential, shipping, installation and safety checks. Discovery is open where lawful; regulated execution remains gated.</div>
      </div>
    </section>

    <section id="view-identity" class="view"><div class="card"><h2>Identity & Profile</h2><p>Profile shell retained. Security depth should adapt to the action: low-risk learning uses basic session assurance; employee, regulated, financial, identity and institutional actions require progressively stronger verification.</p></div></section>
    <section id="view-journey" class="view"><div class="card"><h2>My Journey</h2><p>Progress, credentials, projects, goals and learning history can live here.</p></div></section>
    <section id="view-intelligence" class="view"><div class="card"><h2>My Intelligence</h2><p>Context-aware discoveries, recent research, recommendations and project signals can live here.</p></div></section>
    <section id="view-projects" class="view"><div class="card"><h2>Projects</h2><p>Active project persistence and hand-offs to Research, Create and Build.</p></div></section>
    <section id="view-practice" class="view"><div class="card"><h2>Practice</h2><p>Adaptive knowledge checks can be launched from each lesson and saved to the user profile.</p></div></section>
    <section id="view-research" class="view"><div class="card"><h2>Research</h2><p>Research workspace ready for evidence retrieval, synthesis, project linking and freshness checks once live services are connected.</p></div></section>
    <section id="view-build" class="view"><div class="card"><h2>Build</h2><p>Facilities, laboratories, workflows, utilities and prototypes can be generated from a project brief.</p></div></section>
    <section id="view-career" class="view"><div class="card"><h2>Career</h2><p>Role discovery, credential pathways, skill gaps and jurisdiction-aware career planning.</p></div></section>
  </main>

  <div class="backstrip">
    <button id="backBtn" title="Back">←</button>
    <button id="forwardBtn" title="Forward">→</button>
  </div>

  <div id="lessonModal" class="modal">
    <div class="modal-card">
      <div class="modal-head"><div><strong id="lessonModalTitle">Lesson</strong></div><button id="closeLesson">✕ Close</button></div>
      <div class="modal-body">
        <div class="lesson-shell">
          <aside class="lesson-sidebar card">
            <h3 style="margin-top:0">Lesson path</h3>
            <div class="stack" id="lessonModuleList"></div>
          </aside>
          <div class="lesson-main">
            <div class="lesson-header">
              <div class="breadcrumb" id="lessonBreadcrumb" style="color:#cdd9fa"></div>
              <h2 id="lessonTitle"></h2>
              <p id="lessonSubtitle" style="margin:0;color:#dfe8ff"></p>
            </div>
            <div class="lesson-steps" id="lessonSteps">
              <button class="lesson-step active" data-step="principle">1. Principle</button>
              <button class="lesson-step" data-step="visual">2. Visual</button>
              <button class="lesson-step" data-step="explain">3. Explain</button>
              <button class="lesson-step" data-step="practice">4. Practice</button>
              <button class="lesson-step" data-step="regional">5. Regional</button>
            </div>
            <div class="depth-row" id="lessonDepthRow">
              <button class="depth-btn" data-depth="foundation">Foundation</button><button class="depth-btn active" data-depth="clinical">Clinical</button><button class="depth-btn" data-depth="advanced">Advanced</button><button class="depth-btn" data-depth="scientist">Scientist</button>
            </div>
            <div id="lessonContent"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="creatorModal" class="modal">
    <div class="modal-card" style="width:min(900px,96vw)">
      <div class="modal-head"><strong id="creatorTitle">Creator</strong><button id="closeCreator">✕ Close</button></div>
      <div class="modal-body">
        <div class="grid cols-2">
          <div class="card stack">
            <div class="field"><label>Purpose</label><input id="creatorPurpose" placeholder="What should GPSJ create?" /></div>
            <div class="field"><label>Audience</label><input id="creatorAudience" placeholder="Students, scientists, investors, regulators..." /></div>
            <div class="field"><label>Scientific field</label><input id="creatorField" placeholder="Pharmacology, toxicology, chemistry..." /></div>
            <div class="field"><label>Depth</label><select id="creatorDepth"><option>Foundation</option><option>Clinical</option><option>Advanced</option><option>Scientist</option></select></div>
            <button class="btn primary" id="generateCreator">Generate working draft</button>
          </div>
          <div class="card">
            <div class="panel-title"><h3>Editable draft</h3><div><button class="btn secondary" id="copyDraft">Copy</button></div></div>
            <div id="creatorOutput" class="creator-output">Nothing generated yet.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="languageModal" class="modal">
    <div class="modal-card" style="width:min(900px,96vw)">
      <div class="modal-head"><strong>Language & Scientific Speech Center</strong><button id="closeLanguage">✕ Close</button></div>
      <div class="modal-body">
        <div class="grid cols-2">
          <div class="card">
            <h3>Spoken language</h3>
            <select id="languageSelect" style="width:100%;padding:12px;border-radius:12px;border:1px solid var(--line)">
              <option value="en-US">English — United States</option><option value="en-GB">English — United Kingdom</option><option value="fr-FR">Français — France</option><option value="fr-CA">Français — Canada</option><option value="es-ES">Español</option><option value="de-DE">Deutsch</option><option value="pt-PT">Português</option><option value="ar-SA">العربية</option>
            </select>
            <h3 style="margin-top:18px">Scientific proficiency / exams</h3>
            <div id="examList" class="lang-grid"></div>
          </div>
          <div class="card">
            <h3>Pronunciation behavior</h3>
            <p>Opening speed defaults to <strong>0.75×</strong>, but the learner can choose any supported speed from very slow to fast.</p>
            <div class="speed-row" id="globalSpeedRow"></div>
            <p style="margin-top:18px">Speech reads scientific symbols by meaning. Example: √x → “square root of x” in English and “racine carrée de x” in French.</p>
            <div class="notice">Automatic correction from facial expressions such as a frown would require explicit camera permission and a production privacy/consent design. Voice correction can be enabled when the user explicitly repeats or corrects a term.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const state = {
  view:'home',
  history:['home'],
  historyIndex:0,
  currentTopic:null,
  currentModule:0,
  currentStep:'principle',
  speechRate:0.75,
  language:'en-US',
  currentMarket:'accessible',
  depth:'clinical',
  mastery: JSON.parse(localStorage.getItem('gpsjMastery')||'{}')
};

