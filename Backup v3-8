function principleText(topic,module){
 const map={
  pharmacology:['Drug effect begins with interaction at a biological target.','Exposure determines how much drug reaches the target over time.','Adverse effects are mechanistic consequences of target and off-target actions.'],
  calculations:['Volume required = ordered dose ÷ concentration.','Infusion rate links total volume to delivery time.','Dilution preserves amount of solute while concentration changes.','Percent strength is a ratio that must be translated into units.','Measurements are only useful when units, precision and calibration are verified.'],
  microbiology:['Antimicrobial effect depends on target susceptibility and adequate exposure.','Response depends on exposure relative to organism susceptibility.','Effective therapy requires the correct organism class, susceptible target and adequate exposure.'],
  chemistry:['Structure determines chemical behavior and potential interactions.','Reaction progress depends on reactants, activation conditions and competing pathways.','Formulation performance depends on composition, environment and stability.','Biotechnology systems connect biological machinery to measurable products.'],
  physiology:['Normal physiology provides the baseline for understanding disturbance.','Disease changes a normal system through a mechanism.','Clinical reasoning connects findings to mechanism before intervention.'],
  research:['A research question must be specific enough to test.','Methods determine whether measurements can answer the question.','Inference depends on data quality, design and uncertainty.'],
  toxicology:['Toxic response depends on dose, route, duration and susceptibility.','Target-organ toxicity reflects exposure plus tissue-specific vulnerability.','Risk assessment separates hazard from real-world exposure.'],
  publichealth:['Population outcomes emerge from interacting determinants.','Health systems convert information into coordinated action.','Prevention must be measured against population outcomes.'],
  engineering:['A useful system begins with explicit requirements.','A prototype should make assumptions testable.','Validation links expected performance to measured evidence.']
 };
 return (map[topic]||['Learn the relationship first.'])[module] || 'Learn the relationship first.';
}

