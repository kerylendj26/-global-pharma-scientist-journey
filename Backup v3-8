       <div class="visual-controls"><button class="btn primary" id="playVisual">▶ Animate</button><button class="btn secondary" id="explainVisual">Ask GPSJ why</button></div>
       <div id="visualExplanation" style="margin-top:12px;color:var(--muted)">Adjust values to change the simulated response.</div>
     </div>
   </div>`;
   wireVisual();
 } else if(state.currentStep==='explain'){
   box.innerHTML=`<div class="content-box"><h3>Explain the mechanism</h3><p>${principleText(topic.id,state.currentModule)} The explanation layer connects cause → system change → measurable consequence. Current adaptive depth: <strong>${state.depth}</strong>.</p><textarea id="lessonQuestion" style="width:100%;min-height:100px;border:1px solid var(--line);border-radius:12px;padding:12px" placeholder="Ask GPSJ about this lesson..."></textarea><button class="btn primary" id="lessonExplainBtn" style="margin-top:10px">Explain</button><div id="lessonAnswer" class="notice" style="margin-top:12px;display:none"></div></div>`;
   document.getElementById('lessonExplainBtn').onclick=()=>{const q=document.getElementById('lessonQuestion').value||'Explain this mechanism'; const a=document.getElementById('lessonAnswer');a.style.display='block';a.textContent=`Prototype explanation for “${q}”: ${principleText(topic.id,state.currentModule)} In production this answer would come from the connected AI service with the user’s current depth, language and jurisdiction context.`}
 } else if(state.currentStep==='practice'){
   box.innerHTML=`<div class="content-box"><h3>Adaptive practice</h3><p><strong>Question:</strong> Which approach best matches this lesson?</p><div class="stack"><button class="btn secondary answer" data-ok="1">Understand the relationship and variables before memorizing the procedure.</button><button class="btn secondary answer" data-ok="0">Memorize isolated terms without connecting the mechanism.</button></div><div id="practiceFeedback" style="margin-top:12px"></div></div>`;
   document.querySelectorAll('.answer').forEach(b=>b.onclick=()=>document.getElementById('practiceFeedback').innerHTML=b.dataset.ok==='1'?'<div class="notice" style="background:#eaf8f2;color:#147658;border-color:#b8e6d3">Correct. GPSJ can now increase depth or move to the next mechanism.</div>':'<div class="notice">Review the principle first. The system should reduce depth and re-explain visually.</div>');
 } else if(state.currentStep==='regional'){
