function setView(view, push=true){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  const el=document.getElementById('view-'+view);
  if(el) el.classList.add('active');
  document.querySelectorAll('.navbtn').forEach(b=>b.classList.toggle('active',b.dataset.view===view));
  state.view=view;
  if(push){
    state.history=state.history.slice(0,state.historyIndex+1);
    state.history.push(view); state.historyIndex++;
  }
  window.scrollTo({top:0,behavior:'instant'});
}
document.querySelectorAll('[data-goto]').forEach(b=>b.onclick=()=>setView(b.dataset.goto));
document.querySelectorAll('.navbtn').forEach(b=>b.onclick=()=>setView(b.dataset.view));

document.getElementById('backBtn').onclick=()=>{
  if(state.historyIndex>0){state.historyIndex--;setView(state.history[state.historyIndex],false);}
};
document.getElementById('forwardBtn').onclick=()=>{
  if(state.historyIndex<state.history.length-1){state.historyIndex++;setView(state.history[state.historyIndex],false);}
};
document.getElementById('homeBackupBtn').onclick=()=>setView('home');

function topicMastery(topicId){ const t=topicData.find(x=>x.id===topicId); if(!t)return 0; let done=0; t.modules.forEach((_,i)=>{if(state.mastery[topicId+':'+i]>=1)done++}); return Math.round(done/t.modules.length*100); }
function saveMastery(){localStorage.setItem('gpsjMastery',JSON.stringify(state.mastery)); renderContinue();}
function renderContinue(){const box=document.getElementById('continueLearning'); const raw=localStorage.getItem('gpsjLastLesson'); if(!raw){box.style.display='none';return;} try{const x=JSON.parse(raw),t=topicData.find(v=>v.id===x.topic); if(!t)return; box.style.display='block'; box.innerHTML=`<div class="panel-title"><div><h3 style="margin:0">Continue learning</h3><div class="module-meta">${t.title} · Module ${x.module+1} of ${t.modules.length}</div></div><button class="btn primary" id="continueBtn">Resume</button></div><strong>${t.modules[x.module]}</strong><div class="mastery-bar" style="margin-top:12px"><span style="width:${topicMastery(t.id)}%"></span></div>`; document.getElementById('continueBtn').onclick=()=>openLesson(x.topic,x.module,x.step||'principle');}catch(e){box.style.display='none'}}
function renderTopics(filter=''){
  const grid=document.getElementById('topicGrid');
  const q=filter.trim().toLowerCase();
  const data=topicData.filter(t=>!q || (t.title+' '+t.desc+' '+t.modules.join(' ')).toLowerCase().includes(q));
  grid.innerHTML=data.map(t=>`
    <article class="topic-card">
      <div class="topic-img" style="background-image:url('${t.img}')"></div>
      <div class="topic-body">
        <h3>${t.title}</h3><p>${t.desc}</p><div class="module-meta">${t.modules.length} modules · adapts to ${state.depth} depth</div><div class="mastery-bar" style="margin:10px 0"><span style="width:${topicMastery(t.id)}%"></span></div>
        <button class="btn primary open-topic" data-topic="${t.id}">Explore</button>
      </div>
    </article>`).join('') || '<div class="card">No exact match. Try a broader scientific term.</div>';
  document.querySelectorAll('.open-topic').forEach(b=>b.onclick=()=>openLesson(b.dataset.topic,0,'principle'));
}
