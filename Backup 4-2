function wireVisual(){
 const ranges=[...document.querySelectorAll('.visual-range')];
 function update(){
  ranges.forEach(r=>r.parentElement.querySelector('.range-value').textContent=r.value);
  const vals=ranges.map(r=>+r.value);
  const score=Math.max(0,Math.min(100, Math.round((vals[0]*0.5 + vals[1]*0.35 + (100-vals[2])*0.15))));
  document.getElementById('visualResult').textContent=`Current response index: ${score}%`;
 }
 ranges.forEach(r=>r.oninput=update);
 document.getElementById('playVisual').onclick=()=>{
   let i=0; const timer=setInterval(()=>{i++; ranges[0].value=Math.min(100,+ranges[0].value+2);update();if(i>12)clearInterval(timer)},80);
 };
 document.getElementById('explainVisual').onclick=()=>{
   document.getElementById('visualExplanation').textContent='The simulated response changes because the first two variables increase system drive while the competing pathway reduces effective response. Production GPSJ would generate a topic-specific explanation from the connected AI service.';
 };
}


