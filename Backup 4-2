function getAdaptiveSubtopics(topicId,moduleIndex){
  const specific = adaptiveSubtopics[topicId] && adaptiveSubtopics[topicId][moduleIndex];
  if(specific) return specific;
  const t = topicData.find(x=>x.id===topicId);
  const m = t?.modules[moduleIndex] || 'Current module';
  return [
    `${m}: core concept`,
    `${m}: mechanism`,
    `${m}: variables`,
    `${m}: measurement`,
    `${m}: application`,
    `${m}: common errors`
  ];
}

function saveAdaptiveState(){
  localStorage.setItem('gpsjLearningGoal',state.learningGoal);
  localStorage.setItem('gpsjConfidence',String(state.confidence));
  localStorage.setItem('gpsjSelectedSubtopic',state.selectedSubtopic || '');
  localStorage.setItem('gpsjAdaptiveTrail',JSON.stringify(state.adaptiveTrail.slice(-20)));
}

function addAdaptiveTrail(label){
  const now = new Date();
  state.adaptiveTrail.push(`${now.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} · ${label}`);
  state.adaptiveTrail = state.adaptiveTrail.slice(-20);
  saveAdaptiveState();
}

function adaptiveRecommendation(){
  const topic = topicData.find(x=>x.id===state.currentTopic);
  const mastery = state.mastery[state.currentTopic+':'+state.currentModule] || 0;
  const confidence = state.confidence;

  if(confidence <= 2){
    return {
      title:'Rebuild the concept visually',
      reason:'Confidence is low, so GPSJ should reduce cognitive load, return to the principle and show the mechanism before increasing complexity.',
      action:'visual',
      depth: state.depth==='scientist' ? 'advanced' : (state.depth==='advanced' ? 'clinical' : state.depth)
    };
  }
  if(confidence === 3 && !mastery){
    return {
      title:'Explain, then test one mechanism',
      reason:'Confidence is moderate but mastery is not yet saved. GPSJ should connect the visual to a causal explanation and then ask a focused question.',
      action:'explain',
      depth:state.depth
    };
  }
  if(confidence >= 4 && mastery && state.currentModule < topic.modules.length-1){
    return {
      title:`Advance to Module ${state.currentModule+2}`,
      reason:'Current mastery is saved and confidence is high, so the next best action is to continue the curriculum while preserving the current depth.',
      action:'next-module',
      depth:state.depth
    };
  }
  if(confidence >= 4){
    return {
      title:'Challenge this concept',
      reason:'Confidence is high. GPSJ should test transfer, edge cases and application rather than repeat the same explanation.',
      action:'practice',
      depth: state.depth==='foundation' ? 'clinical' : (state.depth==='clinical' ? 'advanced' : state.depth)
    };
  }
  return {
    title:'Continue through the learning loop',
    reason:'The current state supports another focused step without changing difficulty.',
    action:'practice',
    depth:state.depth
  };
}

