function v448CardsFor(area,map){
  const p=v448Profile();
  if(area==='visual') return p.visual;
  if(area==='lab') return p.lab;
  if(area==='advance') return p.advance;
  if(area==='market') return p.market;

  let base=(map[area]||[]).slice();
  // Preserve the approved six-position organization by filling only when a workspace has fewer than six.
  const extras={
    research:[
      ['🔁 Reproducibility','Controls, replication, calibration, deviations and analysis provenance.',()=>push('Reproducibility',evidenceIntelligence)],
      ['📓 Active notebook','Keep questions, claims, sources, observations and interpretations together.',()=>push('Notebook',evidenceIntelligence)]
    ],
    institutions:[
      ['🎓 Training relationships','Explore institution-linked education and competency pathways.',()=>push('Training relationships',institutionDeep)],
      ['🤝 Verified services','Explore authorized scientific, technical and professional services.',()=>push('Verified services',institutionDeep)]
    ],
    create:[
      ['🎧 Audio & meeting summary','Convert scientific context or meeting summaries into accessible formats.',()=>push('Audio & meeting summary',createDeep)]
    ],
    language:[
      ['🗣️ Scientific listening','Adapt spoken scientific explanations while preserving terminology.',()=>push('Scientific listening',languageDeep)],
      ['🌐 Regional communication','Adapt language and communication style without stereotyping or lowering scientific meaning.',()=>push('Regional communication',languageDeep)]
    ],
    signin:[
      ['🛡️ Permissions & consent','Control saved data, role tools, device permissions and authorized actions.',()=>push('Permissions',signinDeep)],
      ['🔄 Continuity & backup','Preserve authorized scientific context across supported devices and sessions.',()=>push('Continuity',signinDeep)],
      ['🔔 Important notifications','Receive only relevant high-value or owner-level notices.',()=>push('Notifications',signinDeep)]
    ]
  };
  (extras[area]||[]).forEach(x=>{if(base.length<6)base.push(x)});
  return base.slice(0,6);
}

