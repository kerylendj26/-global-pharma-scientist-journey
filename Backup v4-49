  <div class="v446-path"><span class="v446-step">Foundation</span><span class="v446-step">Core science</span><span class="v446-step">System understanding</span><span class="v446-step">Visual model</span><span class="v446-step">Simulation</span><span class="v446-step">Practice</span><span class="v446-step">Assessment</span><span class="v446-step">Mastery</span></div>
