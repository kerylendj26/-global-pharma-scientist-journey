function buildIntentPath(){
  const input=document.getElementById('v446Intent');
  const q=(input?input.value:'').trim();
  if(!q)return;
  GPSJ446.intent=q;localStorage.setItem('gpsj_learning_intent',q);
  const lower=q.toLowerCase();
  let fields=['Relevant scientific field'];
  let prereq=['Foundational concepts'];
  if(/airplane|aircraft|helicopter|drone|flight|aerodynamic/.test(lower)){fields=['Engineering → Aerospace & Aviation','Physics'];prereq=['Mathematics','Mechanics','Forces & motion','Fluid dynamics'];}
  else if(/robot|automation|mechatronic/.test(lower)){fields=['Engineering → Robotics & Mechatronics','Computer Science'];prereq=['Mathematics','Electricity','Programming','Control principles'];}
  else if(/vehicle|car|automotive|engine/.test(lower)){fields=['Engineering → Automotive','Physics'];prereq=['Mechanics','Energy','Electrical fundamentals','Sensors'];}
  else if(/ship|boat|marine|naval/.test(lower)){fields=['Engineering → Marine & Naval','Physics'];prereq=['Mechanics','Fluids','Energy systems','Structures'];}
  else if(/drug|medicine|pharmac/.test(lower)){fields=['Pharmacy & Pharmaceutical Sciences','Biological Sciences','Chemical Sciences'];prereq=['Cell physiology','Chemistry','Biochemistry','Pharmacology foundations'];}
  else if(/cancer|cell|gene|biology/.test(lower)){fields=['Biological Sciences','Medicine & Health Sciences'];prereq=['Cell biology','Genetics','Biochemistry','Physiology'];}
  C.innerHTML=`<div class="v446-choice"><h3>🧠 Adaptive pathway created</h3><p><b>Your goal:</b> ${q}</p></div>
  <div class="v446-map"><h3>Scientific map</h3>
