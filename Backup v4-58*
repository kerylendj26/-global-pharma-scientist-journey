let activeField=learnCatalog[0];
function renderFieldGrid(list=learnCatalog){
 const g=document.getElementById('fieldGrid'); if(!g) return;
 g.innerHTML=list.map(f=>`<button class="field-portal ${activeField&&activeField.id===f.id?'active':''}" onclick="selectField('${f.id}')"><span class="fi">${f.icon}</span><strong>${f.name}</strong><small>${f.desc}</small></button>`).join('');
}
function selectField(id){
 activeField=learnCatalog.find(f=>f.id===id)||learnCatalog[0]; renderFieldGrid();
 const d=document.getElementById('fieldDetail'); if(!d) return;
 d.innerHTML=`<div class="field-detail-head"><div class="field-detail-icon">${activeField.icon}</div><div><h4>${activeField.name}</h4><p class="lead">Enter a domain; the same living-world architecture then adapts to its topics, exercises, equipment, evidence and lawful pathway.</p></div></div><div class="domain-grid">${activeField.domains.map(x=>`<button class="domain-chip" onclick="openDomain('${x.replace(/'/g,"\\'")}')">${x}<span>Open inside ${activeField.name}</span></button>`).join('')}</div>`;
 document.getElementById('hudTitle').textContent=activeField.name+' — Learning World';
 document.getElementById('hudText').textContent=activeField.desc+' The environment, tools and practice stations now reorganize around this field while the full Learn map remains available.';
 document.getElementById('mainGlyph').textContent=activeField.icon;
 document.getElementById('mainTag').textContent=activeField.name.toUpperCase().slice(0,28);
}
function openDomain(name){
 document.getElementById('worldTask').value=name;
 document.getElementById('hudTitle').textContent=name+' — Active Learning Environment';
 document.getElementById('hudText').textContent=`${name} is now the active domain inside ${activeField.name}. GPSJ can unfold foundations, topics, guided manipulation, quizzes, simulated instruments, evidence and advancement without leaving this world.`;
 document.getElementById('sideTag').textContent='ACTIVE DOMAIN';
 document.getElementById('sideGlyph').textContent=activeField.icon;
 document.getElementById('worldStatus').innerHTML='<strong>DOMAIN ACTIVE</strong><br>'+activeField.name+' → '+name+' → topics → adaptive lesson → practice → mastery';
 setDepth('Environment',document.querySelector('#depthNav button'));
}
function filterFields(q){const z=(q||'').toLowerCase().trim();const list=!z?learnCatalog:learnCatalog.filter(f=>(f.name+' '+f.desc+' '+f.domains.join(' ')).toLowerCase().includes(z));renderFieldGrid(list)}
function showLearnMap(show){const el=document.getElementById('learnMap');if(!el)return;el.classList.toggle('show',!!show);if(show){renderFieldGrid();selectField(activeField.id)}}

const sceneBlueprints={
