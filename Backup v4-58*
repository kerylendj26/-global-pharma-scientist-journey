};
const sceneSets={
  learn:['🧪','🔬','📐'],visual:['🖼️','🔎','📏'],research:['🧬','📚','📊'],lab:['⚗️','🔬','🖥️'],advancement:['🎓','🗺️','📋'],create:['🛠️','🧩','📐'],market:['🧰','🏛️','💳'],institution:['🏛️','🧭','🗺️'],language:['🌐','🎙️','📝'],journey:['🧭','🧪','📊'],signin:['👤','🔐','🧭']
};
let currentDepth='Environment';
function setDepth(name,btn){
  currentDepth=name;
  document.querySelectorAll('#depthNav button').forEach(b=>b.classList.remove('active')); if(btn) btn.classList.add('active');
  const d=depthContent[name];
  document.getElementById('depthPanel').innerHTML=`<h4>${d.title}</h4><p>${d.desc}</p><div class="depth-list">${d.items.map(x=>`<div class="depth-item"><strong>${x[0]}</strong>${x[1]}</div>`).join('')}</div><div class="depth-actions"><button onclick="showInfo('${d.title.replace(/'/g,"\'")}','This layer is part of the selected living AI world and inherits the active field, task, evidence and permissions.')">Explain layer</button><button onclick="adaptWorld()">Adapt to my task</button></div>`;
}
function setScene(key){
  const g=sceneSets[key]||sceneSets.learn;
  document.getElementById('mainGlyph').textContent=g[0];document.getElementById('sideGlyph').textContent=g[1];document.getElementById('consoleGlyph').textContent=g[2];
}

let currentWorldKey='learn',currentWorldCard='';
function paintLabels(key){
  const labels=(sceneBlueprints[key]||sceneBlueprints.learn).labels;
  document.getElementById('sceneLabels').innerHTML=labels.map(x=>`<div class="scene-label"><strong>${x[0]}</strong>${x[1]}</div>`).join('');
}
function adaptWorld(){
  const task=(document.getElementById('worldTask').value||'the selected capability').trim();
  const t=task.toLowerCase();
  let mode='Context-adapted scientific environment';
  if(/quiz|exam|practice|homework|problem|calculate/.test(t)) mode='Adaptive practice scene';
  else if(/microscope|hplc|sensor|instrument|equipment|measure/.test(t)) mode='Instrument-aware laboratory scene';
  else if(/research|study|evidence|paper|hypothesis|data/.test(t)) mode='Evidence-connected research scene';
  else if(/museum|university|hospital|institution|school/.test(t)) mode='Institution-specific operational scene';
  else if(/license|certif|credential|qualification|career/.test(t)) mode='Qualification and regulatory pathway scene';
  document.getElementById('hudTitle').textContent=mode;
  document.getElementById('hudText').textContent=`GPSJ is now adapting the visible world to “${task}”. The scene, objects, instruments, evidence and permitted actions change together while the approved screen hierarchy stays unchanged.`;
  document.getElementById('worldStatus').innerHTML='<strong>AI WORLD ADAPTED</strong><br>'+task+' · '+currentDepth.toLowerCase()+' layer · evidence-aware · jurisdiction-aware · permissions-aware';
  document.getElementById('mainTag').textContent=mode.toUpperCase();
  document.getElementById('sideTag').textContent='TASK OBJECT · '+task.slice(0,28).toUpperCase();
}

let lastPage='home';
function renderPage(key){
  const d=data[key]; if(!d) return;
  const el=document.getElementById('page-'+key);
  const cards=d.cards.map((c,i)=>`
    <article class="card ${i===0?'featured':''}">
      ${c[2]?`<span class="relevant">${c[2]}</span>`:''}
      <div class="card-icon" aria-hidden="true">${(cardIcons[key]||[])[i]||'✦'}</div>
      <h3>${c[0]}</h3>
      <p>${c[1]}</p>
      <button onclick="openWorld('${key}', ${i})">Open</button>
      <div class="scene-preview"></div>
    </article>`).join('');
  el.innerHTML=`
    <div class="workspace">
      <div class="ws-head">
        <div class="title-wrap">
          <span class="ws-kicker">FOCUSED WORKSPACE</span>
          <h2>${d.title}</h2><p>${d.subtitle}</p>
        </div>
        <div class="ws-actions"><button onclick="goPage('home')">← Back</button><button onclick="goPage('home')">Workspace home</button></div>
      </div>
      <div class="ws-body">
        <div class="context"><strong>${d.context}</strong>
          <div class="chips"><span class="chip">Field-first</span><span class="chip">Intent-aware</span><span class="chip">Jurisdiction-aware</span><span class="chip">Scientific standards unchanged</span></div>
        </div>
        <div class="cards">${cards}</div>
        <div class="note"><strong>Context follows you.</strong> Opening a capability preserves the active field, learning goal, evidence and lawful pathway instead of rebuilding the same context in another workspace.</div>
        <div class="level-strip"><strong>${key==='institution'?'Institution environment':key==='lab'?'Instrument environment':key==='learn'?'Adaptive learning environment':'Scientific journey'}</strong>
          <span class="level">Curiosity</span><span class="level active">Foundation</span><span class="level">Practice</span><span class="level">Qualification</span><span class="level">Professional</span><span class="level">Research</span>
        </div>
      </div>
    </div>`;
}
Object.keys(data).forEach(renderPage);

function goPage(key){
  lastPage=key;
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('worldView').classList.remove('active');
  document.getElementById('page-'+key).classList.add('active');
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===key));
  window.scrollTo({top:0,behavior:'smooth'});
}
function openWorld(key,index){
  lastPage=key; currentWorldKey=key;
  const c=data[key].cards[index]; currentWorldCard=c[0];
  const isLearnMap=(key==='learn' && c[0]==='Explore science');
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('worldView').classList.add('active');
  document.getElementById('worldTitle').textContent=c[0];
  document.querySelector('.world-shell').dataset.theme=key;
  paintLabels(key);
  setScene(key);
  currentDepth="Environment";
  document.querySelectorAll("#depthNav button").forEach((b,i)=>b.classList.toggle("active",i===0));
  setDepth("Environment");
  document.getElementById('worldTask').value='';
  document.getElementById('worldTask').placeholder='Describe your exact task inside '+c[0]+'…';
  showLearnMap(isLearnMap);
  const wc=worldCopy[c[0]] || [c[0]+' — Living World',c[1]+' The environment now unfolds visually around the selected capability.'];
  document.getElementById('hudTitle').textContent=wc[0];
  document.getElementById('hudText').textContent=wc[1];
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===key));
  window.scrollTo({top:0,behavior:'smooth'});
}
function closeWorld(){goPage(lastPage)}
function setStage(stage){
  document.getElementById('stageLabel').textContent=stage.toUpperCase()+' · ACTIVE ENVIRONMENT';
  const m={
    Curiosity:'The world introduces the field through visible phenomena, safe exploration and simple manipulable representations.',
    Foundation:'Guided learning: concepts, visible objects and safe manipulation are emphasized.',
    Practice:'The scene adds simulated instruments, procedural rehearsal and formative feedback.',
    Qualification:'The scene aligns competencies with recognized training and certification pathways.',
    Professional:'The scene becomes a realistic professional installation with role and jurisdiction boundaries.',
    Research:'The environment expands into advanced instruments, evidence streams, uncertainty and reproducibility.'
  };
  document.getElementById('hudText').textContent=m[stage];
  document.getElementById('worldStatus').innerHTML='<strong>'+stage.toUpperCase()+' MODE</strong><br>'+currentWorldCard+' · scene depth and permissions adapted';
}
function showInfo(t,x){document.getElementById('modalTitle').textContent=t;document.getElementById('modalText').textContent=x;document.getElementById('overlay').classList.add('show')}
function hideInfo(){document.getElementById('overlay').classList.remove('show')}
document.querySelectorAll('[data-page]').forEach(b=>b.addEventListener('click',()=>goPage(b.dataset.page)));
</script>
