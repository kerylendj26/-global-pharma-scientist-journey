  journey:{labels:[['Continuity','Learning + projects + evidence'],['Growth','Curiosity → professional → research'],['Opportunity','Relevant next steps'],['World map','Field distribution and facilities']]},
  signin:{labels:[['Identity','Profile and preferences'],['Credentials','Verified role and qualifications'],['Permissions','Privacy + institutional access'],['Continuity','Resume worlds and work']]}
};

const depthContent={
  Environment:{title:'Operational environment',desc:'The selected capability becomes a living installation instead of a document page.',items:[['Space','AI arranges the room, field site, laboratory, classroom, cockpit, farm, museum or institution to match the activity.'],['Actors','Tutor, learner, scientist, technician or authorized professional roles appear only when relevant.'],['Context','Location, field, level and jurisdiction remain attached to the scene.']]},
  Instruments:{title:'Instrument layer',desc:'Tools appear according to the field, task, competency and what is physically available.',items:[['Visible tools','The world reveals appropriate instruments, sensors, software, models or devices.'],['Connection mode','Read-only observation is separated from simulation, supervised testing and authorized control.'],['Calibration','Compatibility, manuals, measurement limits and evidence provenance stay visible.']]},
  Practice:{title:'Practice layer',desc:'The user can rehearse the real workflow at an appropriate level before any real-world action.',items:[['Guided manipulation','Objects can be rotated, assembled, measured, compared or simulated.'],['Adaptive challenge','Homework, quiz, case, procedure or professional task changes the scene directly.'],['Feedback','AI explains why an action is correct, incomplete or unsafe.']]},
