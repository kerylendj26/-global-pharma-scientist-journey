  create:{labels:[['Project world','Idea becomes an operational environment'],['Evidence','Claims remain source-connected'],['Simulation','Test before real-world action'],['Delivery','Report, model, prototype or service']]},
  market:{labels:[['Need first','Resource appears after scientific fit'],['Verification','Provider / institution / specification'],['Lawful access','Jurisdiction and role aware'],['Transaction','Pricing only after pathway clarity']]},
