  research:{labels:[['Question','Population / system / variables'],['Evidence','Sources + confidence + gaps'],['Method','Design, controls and reproducibility'],['Interpretation','Models, limits and uncertainty']]},
  lab:{labels:[['Nearby hardware','Instruments, sensors and prototypes'],['Mode','Read-only → simulation → supervised test'],['Compatibility','Adapter / manual / calibration'],['Safety','Continuous risk classification']]},
